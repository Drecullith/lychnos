#!/usr/bin/env bash
set -euo pipefail

APP_ID="org.lychnos.prototype.shell"
LIB_DIR="${LYCHNOS_LIB_DIR:-$HOME/.local/lib/lychnos}"
SHELL_BIN="$LIB_DIR/lychnos-shell"
RUNTIME_BIN="$LIB_DIR/lychnos-runtime"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG_DIR="$STATE_HOME/lychnos"
SHELL_LOG="$LOG_DIR/shell.log"
RUNTIME_LOG="$LOG_DIR/runtime.log"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
VOICE_ENV="$CONFIG_HOME/lychnos/voice.env"

if [[ -f "$VOICE_ENV" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$VOICE_ENV"
  set +a
fi

is_shell_running() {
  pgrep -u "$UID" -f "^$SHELL_BIN$" >/dev/null 2>&1
}

is_runtime_running() {
  pgrep -u "$UID" -f "^$RUNTIME_BIN$" >/dev/null 2>&1
}

all_runtime_pids() {
  pgrep -u "$UID" -f '(^|/)lychnos-runtime$' 2>/dev/null || true
}

foreign_runtime_pids() {
  local pid cmd
  while read -r pid; do
    [[ -n "$pid" ]] || continue
    cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    [[ "$cmd" == "$RUNTIME_BIN " || "$cmd" == "$RUNTIME_BIN" ]] && continue
    printf '%s\n' "$pid"
  done < <(all_runtime_pids)
}

ensure_single_runtime() {
  local foreign
  foreign="$(foreign_runtime_pids)"
  if [[ -n "$foreign" ]]; then
    echo "Another Lychnos runtime is already running: $foreign" >&2
    echo "Stop the debug/other runtime before launching the installed Lychnos runtime." >&2
    exit 1
  fi
}

import_graphical_env() {
  if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    return
  fi

  local pid
  pid="$(pgrep -u "$UID" -x quickshell | head -n 1 || true)"
  [[ -n "$pid" && -r "/proc/$pid/environ" ]] || return

  while IFS='=' read -r key value; do
    case "$key" in
      WAYLAND_DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP|HYPRLAND_INSTANCE_SIGNATURE)
        export "$key=$value"
        ;;
    esac
  done < <(tr '\0' '\n' <"/proc/$pid/environ")
}

require_install() {
  for binary in "$RUNTIME_BIN" "$SHELL_BIN"; do
    if [[ ! -x "$binary" ]]; then
      echo "Lychnos is not fully installed; missing $binary" >&2
      exit 1
    fi
  done
}

start_runtime() {
  if is_runtime_running; then
    return
  fi

  mkdir -p "$LOG_DIR"
  nohup "$RUNTIME_BIN" >>"$RUNTIME_LOG" 2>&1 &
  local pid=$!

  for _ in {1..30}; do
    if is_runtime_running; then
      echo "Lychnos runtime started (PID $pid)."
      return
    fi
    sleep 0.1
  done

  echo "Lychnos runtime did not stay running. Check: $RUNTIME_LOG" >&2
  exit 1
}

start_shell() {
  if is_shell_running; then
    gapplication action "$APP_ID" restore >/dev/null 2>&1 || true
    echo "Lychnos shell is already running; restored him."
    return
  fi

  mkdir -p "$LOG_DIR"
  nohup "$SHELL_BIN" >>"$SHELL_LOG" 2>&1 &
  local pid=$!

  for _ in {1..30}; do
    if is_shell_running; then
      echo "Lychnos shell started (PID $pid)."
      return
    fi
    sleep 0.1
  done

  echo "Lychnos shell did not stay running. Check: $SHELL_LOG" >&2
  exit 1
}

start_all() {
  import_graphical_env
  require_install
  ensure_single_runtime
  start_runtime
  start_shell
}

stop_all() {
  local stopped=false

  if is_shell_running; then
    pkill -TERM -u "$UID" -f "^$SHELL_BIN$"
    echo "Lychnos shell stopped."
    stopped=true
  fi

  if is_runtime_running; then
    pkill -TERM -u "$UID" -f "^$RUNTIME_BIN$"
    echo "Lychnos runtime stopped."
    stopped=true
  fi

  # Safety cleanup for an explicitly active PTT recorder if the runtime is
  # terminated before it can process a normal StopPushToTalk request.
  pkill -INT -u "$UID" -f 'pw-record .*lychnos/audio/ptt-' 2>/dev/null || true

  if [[ "$stopped" == false ]]; then
    echo "Lychnos is not running."
  fi
}

status_all() {
  local failed=false

  if is_runtime_running; then
    echo "Runtime: running"
  else
    echo "Runtime: stopped"
    failed=true
  fi

  if is_shell_running; then
    echo "Shell:   running"
  else
    echo "Shell:   stopped"
    failed=true
  fi

  [[ "$failed" == false ]]
}

show_logs() {
  mkdir -p "$LOG_DIR"
  touch "$RUNTIME_LOG" "$SHELL_LOG"

  echo "=== Lychnos runtime ==="
  tail -n 50 "$RUNTIME_LOG"
  echo
  echo "=== Lychnos shell ==="
  tail -n 50 "$SHELL_LOG"
}

case "${1:-start}" in
  start|launch|show) start_all ;;
  stop|close) stop_all ;;
  restart)
    stop_all || true
    start_all
    ;;
  status) status_all ;;
  logs) show_logs ;;
  help|-h|--help)
    cat <<'EOF'
Usage: lychnos [command]

Commands:
  start     Launch the Lychnos runtime and shell, or restore the existing shell
  stop      Close the shell and stop the user-level runtime
  restart   Restart both runtime and shell
  status    Show runtime and shell status
  logs      Show recent runtime and shell logs
  help      Show this help

Running 'lychnos' with no command is the same as 'lychnos start'.
EOF
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Run 'lychnos help' for usage." >&2
    exit 2
    ;;
esac
